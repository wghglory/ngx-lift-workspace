{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "ngx-lift": ["libs/ngx-lift/src/index.ts"],
      "clr-lift": ["libs/clr-lift/src/index.ts"],
      "clr-lift/devtools": ["libs/clr-lift/devtools/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
