{
  "name": "@ngx-lift-workspace/source",
  "version": "21.2.0",
  "license": "MIT",
  "author": "Derek Wang <guanghui-wang@foxmail.com>",
  "keywords": [
    "angular",
    "ngx-lift",
    "clr-lift"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wghglory/ngx-lift-workspace.git"
  },
  "homepage": "https://ngx-lift.netlify.app/",
  "description": "Monorepo containing ngx-lift and clr-lift - powerful Angular utility and component libraries to enhance and simplify your Angular development experience.",
  "scripts": {
    "start": "nx serve demo",
    "build": "nx run-many -t build",
    "build:libs": "nx run-many -t build --projects=ngx-lift,clr-lift",
    "build:demo": "nx build demo --configuration=production",
    "build:ngx": "nx build ngx-lift",
    "build:clr": "nx build clr-lift",
    "watch:ngx": "nx build ngx-lift --watch",
    "watch:clr": "nx build clr-lift --watch",
    "test": "nx run-many -t test",
    "test:ngx": "nx test ngx-lift",
    "test:clr": "nx test clr-lift",
    "test:coverage": "node tools/vitest/run-coverage.mjs",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "typecheck": "nx run-many -t typecheck",
    "e2e": "nx e2e demo-e2e",
    "e2e:ui": "nx e2e demo-e2e --ui",
    "e2e:lint": "nx lint demo-e2e",
    "e2e:verify": "pnpm run e2e:lint && pnpm run e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css,scss,md,html,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css,scss,md,html,yml,yaml}\"",
    "format:examples": "nx run @ngx-lift-workspace/source:demo-examples-format",
    "affected:test": "nx affected -t test",
    "affected:build": "nx affected -t build",
    "affected:lint": "nx affected -t lint",
    "graph": "nx graph",
    "clean": "nx reset && rm -rf dist tmp .nx/cache",
    "validate": "pnpm run format:check && pnpm run test:tools && pnpm run i18n:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run bundle:check && pnpm run verify:packages",
    "release:version": "nx release version",
    "release:publish": "nx release publish",
    "publish:ngx": "nx build ngx-lift && cd dist/libs/ngx-lift && pnpm publish --registry=https://registry.npmjs.org/",
    "publish:clr": "nx build clr-lift && cd dist/libs/clr-lift && pnpm publish --registry=https://registry.npmjs.org/",
    "publish:all": "pnpm run build:libs && pnpm run publish:ngx && pnpm run publish:clr",
    "prepare": "husky",
    "fix": "pnpm run format && pnpm run lint:fix",
    "test:tools": "nx run @ngx-lift-workspace/source:tooling-test",
    "i18n:check": "nx run @ngx-lift-workspace/source:i18n-check",
    "verify:packages": "nx run @ngx-lift-workspace/source:package-verify",
    "bundle:check": "nx run @ngx-lift-workspace/source:bundle-check"
  },
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@angular/animations": "21.2.17",
    "@angular/cdk": "21.2.10",
    "@angular/common": "21.2.20",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.20",
    "@angular/forms": "21.2.17",
    "@angular/platform-browser": "21.2.17",
    "@angular/platform-browser-dynamic": "21.2.17",
    "@angular/router": "21.2.17",
    "@clr/angular": "^18.4.0",
    "@clr/ui": "^18.4.0",
    "node-forge": "^1.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.1.3",
    "@analogjs/vitest-angular": "2.1.3",
    "@angular-devkit/build-angular": "21.2.14",
    "@angular-devkit/core": "21.2.14",
    "@angular-devkit/schematics": "21.2.14",
    "@angular/build": "21.2.14",
    "@angular/cli": "21.2.14",
    "@angular/compiler-cli": "21.2.17",
    "@angular/language-service": "21.2.17",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-angular": "^21.0.2",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "22.7.5",
    "@nx/devkit": "22.7.5",
    "@nx/eslint": "22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/js": "22.7.5",
    "@nx/playwright": "22.7.5",
    "@nx/vite": "22.7.5",
    "@nx/vitest": "22.7.5",
    "@nx/web": "22.7.5",
    "@nx/workspace": "22.7.5",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "21.2.14",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.23",
    "@types/node": "24.13.2",
    "@types/node-forge": "^1.3.11",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "angular-eslint": "21.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "highlight.js": "^11.12.0",
    "husky": "^9.0.11",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^15.2.0",
    "ng-packagr": "21.2.5",
    "nx": "22.7.10",
    "postcss": "^8.5.23",
    "postcss-url": "~10.1.4",
    "prettier": "^3.3.3",
    "ts-node": "10.9.1",
    "tslib": "^2.6.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "verdaccio": "6.7.2",
    "vite": "^7.3.5",
    "vitest": "4.1.11"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "tooling-test": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "node --test tools/eslint-plugin/*.test.mjs tools/i18n/*.test.mjs tools/bundle/*.test.mjs tools/demo/*.test.mjs",
            "node tools/demo/format-examples.mjs"
          ],
          "parallel": false
        }
      },
      "demo-examples-format": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/demo/format-examples.mjs --write"
        }
      },
      "i18n-check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/i18n/check-translations.mjs"
        }
      },
      "package-verify": {
        "executor": "nx:run-commands",
        "dependsOn": [
          {
            "projects": [
              "ngx-lift",
              "clr-lift"
            ],
            "target": "build"
          }
        ],
        "options": {
          "command": "node tools/package/verify-packages.mjs"
        }
      },
      "bundle-check": {
        "executor": "nx:run-commands",
        "dependsOn": [
          {
            "projects": [
              "demo"
            ],
            "target": "build"
          }
        ],
        "options": {
          "command": "node tools/bundle/check-lazy-dependencies.mjs"
        }
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md,html}": [
      "prettier --write"
    ]
  }
}
